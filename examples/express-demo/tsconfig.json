{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS on purpose: OpenTelemetry auto-instruments pino/express via
    // require-in-the-middle, which only fires when these libraries are require()d.
    // Compiling to CJS makes that happen even though the source uses `import`.
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "build",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
