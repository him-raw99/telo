{
  "name": "telo",
  "version": "0.1.0",
  "author": {
    "name": "Himanshu Rawat",
    "email": "him.raw.official1@gmail.com",
    "url": "https://himraw99.vercel.app"
  },
  "description": "Telemetry collection, made super easy — one line for any Node.js app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/him-raw99/telo.git",
    "directory": "packages/telo-node"
  },
  "homepage": "https://github.com/him-raw99/telo/tree/main/packages/telo-node#readme",
  "bugs": {
    "url": "https://github.com/him-raw99/telo/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "yarn build && yarn typecheck && yarn lint"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "telemetry",
    "observability",
    "tracing",
    "metrics",
    "logs",
    "nodejs"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation-amqplib": "^0.65.0",
    "@opentelemetry/instrumentation-dns": "^0.61.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.27.0",
    "@opentelemetry/instrumentation-mongoose": "^0.64.0",
    "@opentelemetry/instrumentation-mysql": "^0.64.0",
    "@opentelemetry/instrumentation-mysql2": "^0.64.0",
    "@opentelemetry/instrumentation-pg": "^0.70.0",
    "@opentelemetry/instrumentation-pino": "^0.65.0",
    "@opentelemetry/instrumentation-redis": "^0.66.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.31.0",
    "@opentelemetry/instrumentation-winston": "^0.63.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
